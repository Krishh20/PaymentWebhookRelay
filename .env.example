# Copy this file to backend/.env before starting the backend:
#   PowerShell: Copy-Item .env.example backend/.env
#   bash:       cp .env.example backend/.env
# Do not commit backend/.env.

NODE_ENV=development
PORT=4000

# Local PostgreSQL started with `npm run db:start` (docker-compose.yml)
DATABASE_URL=postgresql://relay:relay_dev_password@localhost:5432/payment_relay?schema=public

# ---------------------------------------------------------------------------
# Internal source configuration (one source for this project)
# ---------------------------------------------------------------------------
WEBHOOK_SOURCE_NAME=Postman Sandbox
WEBHOOK_SOURCE_SLUG=postman-sandbox
WEBHOOK_SIGNATURE_HEADER=x-webhook-signature

# HMAC-SHA256 secret used to verify incoming webhooks.
# Development value only. Use a long random value outside local testing.
WEBHOOK_SECRET=whsec_test_2f7c9a1e5b8d4f6a9c0e3b7d1f5a8c2e

# ---------------------------------------------------------------------------
# Single delivery destination
# Mock endpoints on the same Express backend:
#   /mock/success       always HTTP 200
#   /mock/failure       always HTTP 500
#   /mock/timeout       never answers before the delivery timeout
#   /mock/intermittent  HTTP 503 on the first attempt, HTTP 200 afterwards
# ---------------------------------------------------------------------------
DESTINATION_NAME=Local Mock Destination
DESTINATION_URL=http://localhost:4000/mock/success
DESTINATION_TIMEOUT_MS=10000
